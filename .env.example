# Austria-web 環境變數範本（複製成 .env 填值）
# vault markdown 路徑（本機開發用，CI 中由 workflow 注入）
NOTES_DIR="D:\\奧地利-vault"

# Worker API base URL（Worker 部署後填入，例如 https://austria-dashboard.<你的子網域>.workers.dev；
# 空白時前端走純 localStorage 離線模式）
VITE_API_BASE=

# Cloudflare（wrangler deploy、sync:images 用）
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# 圖片放 R2 時才需要：bucket 名稱與公開網址前綴（例如 https://img.example.com）
CLOUDFLARE_R2_BUCKET_NAME=
R2_PUBLIC_URL_PREFIX=
